{
  "name": "quickloke-patcher-app",
  "private": true,
  "version": "0.1.0-pre-alpha.11",
  "type": "module",
  "scripts": {
    "tauri": "tauri",
    "dev": "tauri dev",
    "ui:dev": "vite --host 0.0.0.0",
    "ui:build": "tsc --noEmit && vite build",
    "icons": "tauri icon branding/icon.svg",
    "build": "npm run icons && tauri build",
    "android:init": "npm run icons && tauri android init",
    "android:build": "npm run icons && tauri android build",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "check": "npm run ui:build && npm run test:rust"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-dialog": "2.7.2",
    "@tauri-apps/plugin-fs": "2.5.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "typescript": "7.0.2",
    "vite": "8.2.0"
  }
}
